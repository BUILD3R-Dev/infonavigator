---
import { SITE, NAV } from '../data/site';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  ogType?: string;
}

const { title, description, canonical, noindex, schema, ogType = 'article' } = Astro.props;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, SITE.url).toString();
const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="twitter:card" content="summary" />
    <!-- GA4: set GA_MEASUREMENT_ID in src/data/site.ts once Dustin creates the infonavigator.org data stream -->
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='18' fill='%23111'/><rect x='18' y='28' width='12' height='44' fill='white'/><rect x='34' y='28' width='12' height='44' fill='white'/><rect x='50' y='28' width='12' height='44' fill='white'/><rect x='66' y='28' width='12' height='44' fill='white'/><rect x='28' y='28' width='9' height='26' fill='%23111'/><rect x='45' y='28' width='9' height='26' fill='%23111'/><rect x='62' y='28' width='9' height='26' fill='%23111'/></svg>" />
    {schemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
    <style is:global>
      /* ============ InfoNavigator design system (ported from bestpianoapp.com) ============ */
      :root {
        --ink: #16161a;
        --ink-soft: #232329;
        --muted: #55565e;
        --faint: #8a8a93;
        --line: #e6e6ea;
        --bg: #ffffff;
        --soft: #f7f7f9;
        --accent: #b8860b;
        --accent-ink: #7a5c06;
        --accent-soft: #faf3df;
        --gold-hi: #e0c060;
        --good: #1a7f4b;
        --good-bg: #e9f6ef;
        --bad: #b3261e;
        --bad-bg: #fbecea;
        --radius: 16px;
        --radius-sm: 10px;
        --shadow-sm: 0 1px 2px rgba(22, 22, 26, 0.06);
        --shadow-md: 0 10px 28px rgba(22, 22, 26, 0.12);
      }
      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
      ::selection { background: #f4d47c; }
      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        color: var(--ink);
        background: var(--bg);
        line-height: 1.65;
        font-size: 17px;
      }
      img { max-width: 100%; height: auto; }
      :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

      /* ---- type scale ---- */
      h1 {
        font-size: clamp(2.1rem, 1.5rem + 3.2vw, 3rem);
        line-height: 1.08;
        letter-spacing: -0.03em;
        margin: 0.6rem 0 1.1rem;
      }
      h2 {
        font-size: 1.5rem;
        letter-spacing: -0.02em;
        line-height: 1.25;
        margin: 2.6rem 0 1rem;
        border-top: 1px solid var(--line);
        padding-top: 1.7rem;
      }
      h3 { font-size: 1.2rem; letter-spacing: -0.015em; margin: 1.8rem 0 0.6rem; line-height: 1.3; }
      p, li { color: var(--ink-soft); }
      .lede { font-size: 1.16rem; color: var(--muted); max-width: 62ch; }

      /* ---- links: publication style, no cheap blue ---- */
      a { color: var(--accent-ink); text-decoration: none; transition: color 0.15s ease; }
      a:hover { text-decoration: underline; text-underline-offset: 3px; }

      .wrap { max-width: 76ch; margin: 0 auto; padding: 0 1.25rem; }
      .wrap-wide { max-width: 1120px; margin: 0 auto; padding: 0 1.25rem; }

      /* ---- header ---- */
      header.site {
        border-bottom: 1px solid var(--line);
        background: rgba(255, 255, 255, 0.97);
        backdrop-filter: blur(6px);
        position: sticky;
        top: 0;
        z-index: 50;
        box-shadow: 0 1px 3px rgba(22, 22, 26, 0.05);
      }
      .nav { display: flex; align-items: center; gap: 1.25rem; padding: 0.85rem 0; flex-wrap: wrap; }
      .brand { font-weight: 800; font-size: 1.15rem; color: var(--ink); text-decoration: none; letter-spacing: -0.02em; }
      .brand:hover { text-decoration: none; }
      .brand span { color: var(--accent); }
      nav.links { display: flex; gap: 1.1rem; margin-left: auto; flex-wrap: wrap; font-size: 0.95rem; }
      nav.links a { color: var(--muted); text-decoration: none; font-weight: 600; }
      nav.links a:hover { color: var(--ink); text-decoration: underline; text-underline-offset: 4px; }

      main { padding: 2rem 0 3.5rem; }

      /* ---- hero (homepage) ---- */
      .hero {
        background:
          radial-gradient(1100px 480px at 18% -10%, rgba(184, 134, 11, 0.25), transparent 60%),
          radial-gradient(800px 400px at 90% 110%, rgba(184, 134, 11, 0.12), transparent 55%),
          var(--ink);
        color: #f4f2ec;
        margin: -2rem 0 0;
        padding: 3.75rem 0 3.25rem;
      }
      .hero-eyebrow {
        color: var(--gold-hi);
        font-size: 0.78rem;
        font-weight: 800;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        margin: 0 0 0.9rem;
      }
      .hero h1 { color: #ffffff; margin: 0 0 1.1rem; max-width: 20ch; }
      .hero-sub { color: #cfccc2; font-size: 1.16rem; max-width: 62ch; margin: 0; }
      .hero-sub strong { color: #ffffff; }
      .hero-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; margin: 1.75rem 0 2.25rem; }
      .hero-actions .btn { margin: 0; }
      .trust-row {
        list-style: none;
        display: flex;
        gap: 1.75rem;
        flex-wrap: wrap;
        margin: 0;
        padding: 1.4rem 0 0;
        border-top: 1px solid rgba(255, 255, 255, 0.14);
      }
      .trust-row li { display: flex; gap: 0.6rem; align-items: flex-start; font-size: 0.9rem; color: #d8d5cb; max-width: 21rem; line-height: 1.5; }
      .trust-row li::before { content: "✓"; color: var(--gold-hi); font-weight: 800; flex: none; }
      .trust-row strong { color: #ffffff; font-weight: 700; }

      /* ---- buttons: every CTA is a button, never a bare link ---- */
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        background: var(--ink);
        color: #ffffff;
        font-weight: 700;
        font-size: 1rem;
        line-height: 1.3;
        padding: 0.8rem 1.6rem;
        border-radius: 12px;
        border: 1px solid var(--ink);
        text-decoration: none;
        cursor: pointer;
        margin: 0.5rem 0.5rem 0.5rem 0;
        transition: transform 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;
      }
      .btn:hover { background: #000000; border-color: #000000; color: #ffffff; text-decoration: none; transform: translateY(-1px); box-shadow: var(--shadow-md); }
      .btn-ghost { background: #ffffff; color: var(--ink); border: 1px solid var(--line); box-shadow: var(--shadow-sm); }
      .btn-ghost:hover { background: var(--soft); border-color: #c9c9d1; color: var(--ink); box-shadow: var(--shadow-md); }
      .btn-gold { background: linear-gradient(135deg, #d9a821, var(--accent)); border-color: #a67c0a; color: var(--ink); }
      .btn-gold:hover { background: linear-gradient(135deg, #e7b62e, #c08f0d); border-color: #a67c0a; color: var(--ink); }
      .btn-outline-light { background: transparent; border: 1px solid rgba(255, 255, 255, 0.4); color: #ffffff; }
      .btn-outline-light:hover { background: rgba(255, 255, 255, 0.12); border-color: rgba(255, 255, 255, 0.7); color: #ffffff; }
      .btn-lg { font-size: 1.08rem; padding: 0.95rem 2rem; }

      /* ---- cards ---- */
      .card {
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 1.5rem;
        background: #ffffff;
        margin: 1.25rem 0;
        box-shadow: var(--shadow-sm);
        transition: box-shadow 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
      }
      .card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); border-color: #d5d5db; }
      .card h3 { margin-top: 0; font-size: 1.35rem; }
      .card h3 a { color: var(--ink); text-decoration: none; }
      .card h3 a:hover { color: var(--accent-ink); text-decoration: underline; text-underline-offset: 3px; }
      .card-top3 { border: 2px solid var(--accent); background: linear-gradient(180deg, #fffdf6, #ffffff); }
      .card-tagline { margin: 0.3rem 0 0.8rem; color: var(--muted); }
      .card-score { margin: 0.6rem 0; }
      .card-verdict { border-left: 3px solid var(--accent); padding-left: 0.9rem; color: #3a3a41; font-style: italic; margin: 0.9rem 0; }
      .card-actions { display: flex; gap: 0.25rem; flex-wrap: wrap; margin-top: 1.1rem; align-items: center; }
      .rank-badge {
        display: inline-block;
        font-weight: 800;
        font-size: 0.78rem;
        letter-spacing: 0.04em;
        background: var(--ink);
        color: #ffffff;
        border-radius: 999px;
        padding: 0.28rem 0.8rem;
        margin-bottom: 0.6rem;
      }
      .rank-badge.gold { background: linear-gradient(135deg, #d9a821, var(--accent)); color: var(--ink); }

      /* ---- MetaScore badge: color-coded by band ---- */
      .metascore {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        font-weight: 700;
        background: var(--soft);
        border: 1px solid var(--line);
        padding: 0.4rem 0.85rem;
        border-radius: 999px;
      }
      .metascore .num { font-size: 1.35rem; letter-spacing: -0.02em; color: var(--ink); }
      .metascore .bar { width: 120px; height: 10px; background: #dcdce1; border-radius: 999px; overflow: hidden; flex: none; }
      .metascore .fill { height: 100%; border-radius: 999px; }
      .fill.ms-high { background: linear-gradient(90deg, var(--good), #35a56a); }
      .fill.ms-mid { background: linear-gradient(90deg, var(--accent), #e3ac2c); }
      .fill.ms-low { background: #a2a2ab; }
      .metascore .ms-label { font-weight: 400; font-size: 0.85rem; color: var(--muted); }
      .metascore .ms-sources { font-weight: 400; font-size: 0.8rem; color: var(--muted); }
      .provisional {
        font-weight: 700;
        font-size: 0.76rem;
        color: var(--accent-ink);
        background: var(--accent-soft);
        border: 1px solid #e8d48a;
        padding: 0.12rem 0.6rem;
        border-radius: 999px;
        white-space: nowrap;
      }
      .ms-how { font-size: 0.85rem; margin-left: 0.4rem; white-space: nowrap; }

      /* ---- chips ---- */
      .chips { display: flex; gap: 0.45rem; flex-wrap: wrap; margin: 0.6rem 0; }
      .chip { font-size: 0.8rem; font-weight: 600; background: var(--soft); border: 1px solid var(--line); border-radius: 999px; padding: 0.18rem 0.7rem; color: var(--muted); }

      /* ---- pros / cons ---- */
      .proscons { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin: 1.5rem 0; }
      .pros, .cons { border-radius: 12px; padding: 1.15rem 1.3rem; border: 1px solid; }
      .pros { background: var(--good-bg); border-color: #bfe3cf; }
      .cons { background: var(--bad-bg); border-color: #f0c4c0; }
      .pros h3, .cons h3 { margin: 0 0 0.4rem; font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.06em; }
      .pros h3 { color: var(--good); }
      .cons h3 { color: var(--bad); }
      .pros ul, .cons ul { margin: 0.4rem 0 0; padding-left: 1.15rem; }
      .pros li, .cons li { margin: 0.35rem 0; color: #2a2a30; }
      .pros li::marker { color: var(--good); font-weight: 800; }
      .cons li::marker { color: var(--bad); font-weight: 800; }

      /* ---- verdict ---- */
      .verdict {
        background: var(--soft);
        border: 1px solid var(--line);
        border-left: 4px solid var(--accent);
        border-radius: 0 12px 12px 0;
        padding: 1.15rem 1.4rem;
        margin: 2rem 0;
        box-shadow: var(--shadow-sm);
      }
      .verdict > strong:first-child { display: block; margin-bottom: 0.4rem; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.07em; color: var(--accent-ink); }
      .verdict p { margin: 0.5rem 0; }
      .verdict p:first-of-type { margin-top: 0; }
      .verdict p:last-child { margin-bottom: 0; }

      /* ---- disclosure & verification ---- */
      .disclosure { font-size: 0.87rem; color: var(--muted); background: var(--soft); border: 1px dashed #c9c9d1; border-radius: 12px; padding: 1rem 1.25rem; margin: 2.5rem 0 1rem; }
      .disclosure strong { color: var(--ink-soft); }
      .verified { font-size: 0.82rem; color: var(--faint); margin: 2rem 0 0; padding-top: 1.1rem; border-top: 1px solid var(--line); display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; }
      .verified::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--good); flex: none; }

      /* ---- FAQ accordions ---- */
      .faq details { border: 1px solid var(--line); border-radius: 12px; margin: 0.6rem 0; padding: 0; background: #ffffff; overflow: hidden; transition: box-shadow 0.15s ease, border-color 0.15s ease; }
      .faq details[open] { box-shadow: var(--shadow-sm); border-color: #d5d5db; }
      .faq summary { font-weight: 700; cursor: pointer; padding: 0.95rem 1.2rem; list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 1rem; color: var(--ink); }
      .faq summary::-webkit-details-marker { display: none; }
      .faq summary::after { content: "+"; font-size: 1.35rem; font-weight: 400; line-height: 1; color: var(--accent-ink); flex: none; }
      .faq details[open] summary::after { content: "–"; }
      .faq summary:hover { background: var(--soft); }
      .faq details p { padding: 0 1.2rem 1.1rem; margin: 0; color: #3a3a41; }

      /* ---- breadcrumbs ---- */
      .crumbs { font-size: 0.85rem; color: var(--faint); margin-bottom: 0.75rem; }
      .crumbs a { color: var(--muted); }
      .crumbs a:hover { color: var(--accent-ink); }

      /* ---- featured partner callout ---- */
      .featured-callout {
        border: 2px solid var(--accent);
        border-radius: var(--radius);
        padding: 1.75rem;
        background: linear-gradient(180deg, #fffdf4, #fffaf0);
        margin: 2rem 0;
        box-shadow: 0 12px 32px rgba(184, 134, 11, 0.14);
      }
      .featured-callout .tag {
        display: inline-block;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--ink);
        background: linear-gradient(135deg, #d9a821, var(--accent));
        padding: 0.32rem 0.85rem;
        border-radius: 999px;
        margin-bottom: 0.8rem;
      }
      .featured-callout h3 { font-size: 1.5rem; margin: 0 0 0.4rem; }
      .featured-callout .featured-price { font-size: 0.95rem; color: var(--muted); margin: 0.7rem 0 1.1rem; }
      .featured-callout .featured-note { font-size: 0.82rem; color: var(--muted); margin: 1rem 0 0; }

      /* ---- comparison tables ---- */
      .cmp-scroll { overflow-x: auto; border: 1px solid var(--line); border-radius: 12px; background: #ffffff; margin: 1.5rem 0; box-shadow: var(--shadow-sm); }
      .cmp-scroll--tall { max-height: 78vh; overflow-y: auto; }
      table.cmp { width: 100%; border-collapse: separate; border-spacing: 0; font-size: 0.92rem; margin: 0; }
      table.cmp.cmp--wide { min-width: 780px; }
      table.cmp caption { text-align: left; font-weight: 700; padding: 0.9rem 1rem; font-size: 1rem; color: var(--ink); }
      table.cmp th, table.cmp td { padding: 0.7rem 0.9rem; text-align: left; vertical-align: top; border-bottom: 1px solid var(--line); }
      table.cmp thead th {
        position: sticky;
        top: 0;
        z-index: 3;
        background: var(--ink);
        color: #f4f2ec;
        font-size: 0.76rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        white-space: nowrap;
      }
      table.cmp thead th a { color: #f4d47c; }
      table.cmp thead th a:hover { color: #ffffff; }
      table.cmp tbody tr:nth-child(even) td { background: var(--soft); }
      table.cmp tbody tr:hover td { background: #f5f1e2; }
      table.cmp tbody tr:last-child td { border-bottom: none; }
      table.cmp--wide td:first-child, table.cmp--wide th:first-child { position: sticky; left: 0; z-index: 2; }
      table.cmp--wide thead th:first-child { z-index: 4; }
      table.cmp--wide tbody td:first-child { background: #ffffff; font-weight: 600; box-shadow: 1px 0 0 var(--line); }
      table.cmp--wide tbody tr:nth-child(even) td:first-child { background: var(--soft); }
      table.cmp--wide tbody tr:hover td:first-child { background: #f5f1e2; }
      table.cmp--facts td:first-child { font-weight: 700; background: var(--soft); width: 32%; white-space: nowrap; }
      table.cmp--facts tbody tr:nth-child(even) td:first-child { background: #efeff2; }
      table.cmp--facts tbody tr:hover td:first-child { background: #e9e4d2; }

      /* ---- ranking rows (best-piano-apps full ranking) ---- */
      .rank-row { padding: 1.6rem 0; border-bottom: 1px solid var(--line); }
      .rank-row:last-of-type { border-bottom: none; }
      .rank-row h3 { margin: 0 0 0.6rem; display: flex; align-items: center; gap: 0.65rem; flex-wrap: wrap; font-size: 1.3rem; }
      .rank-row h3 .rank-badge { margin-bottom: 0; }
      .rank-row h3 a { color: var(--ink); text-decoration: none; }
      .rank-row h3 a:hover { color: var(--accent-ink); text-decoration: underline; text-underline-offset: 3px; }
      .rank-row .rank-price { color: var(--muted); font-size: 0.95rem; margin: 0.4rem 0; }

      /* ---- footer: dark ink to ground the page ---- */
      footer.site { background: var(--ink); color: #b9b7ae; padding: 2.75rem 0 3rem; font-size: 0.9rem; }
      footer.site nav { display: flex; gap: 1.5rem; flex-wrap: wrap; margin-bottom: 1.25rem; }
      footer.site a { color: #e8e4d6; text-decoration: none; font-weight: 600; }
      footer.site a:hover { color: #f4d47c; text-decoration: underline; text-underline-offset: 3px; }
      footer.site p { color: #8f8d85; margin: 0.45rem 0; }
      footer.site .brand { color: #ffffff; }

      /* ---- layout helpers ---- */
      .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
      .grid2 > div > .btn { margin-bottom: 0; }

      /* ---- quiz ---- */
      .quiz-q { margin: 1.5rem 0; display: grid; gap: 0.65rem; }
      .quiz-q button {
        display: block;
        width: 100%;
        text-align: left;
        padding: 1.05rem 1.3rem;
        border: 1.5px solid var(--line);
        border-radius: 12px;
        background: #ffffff;
        font-family: inherit;
        font-size: 1.02rem;
        font-weight: 600;
        color: var(--ink);
        cursor: pointer;
        box-shadow: var(--shadow-sm);
        transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
      }
      .quiz-q button:hover { border-color: var(--accent); background: #fffdf4; transform: translateY(-1px); box-shadow: var(--shadow-md); }
      .quiz-q button:active { transform: translateY(0); }

      /* ---- mobile ---- */
      @media (max-width: 700px) {
        body { font-size: 16px; }
        .grid2 { grid-template-columns: 1fr; }
        .proscons { grid-template-columns: 1fr; }
        .hero { padding: 2.5rem 0 2.25rem; }
        .trust-row { flex-direction: column; gap: 0.9rem; }
        .trust-row li { max-width: none; }
        .card { padding: 1.2rem; }
        .featured-callout { padding: 1.25rem; }
        .btn-lg { font-size: 1rem; padding: 0.85rem 1.5rem; }
        nav.links { gap: 0.85rem; font-size: 0.9rem; }
        .metascore .bar { width: 84px; }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after { transition: none !important; }
      }
    </style>
  </head>
  <body>
    <header class="site">
      <div class="wrap-wide nav">
        <a class="brand" href="/"><span>◈</span> InfoNavigator</a>
        <nav class="links" aria-label="Primary">
          {NAV.map((n) => <a href={n.href}>{n.label}</a>)}
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site">
      <div class="wrap-wide">
        <a class="brand" href="/"><span>◈</span> InfoNavigator</a>
        <nav aria-label="Footer">
          <a href="/about/">About</a>
          <a href="/how-we-rate/">How we rate</a>
          <a href="/disclosure/">Affiliate disclosure</a>
          <a href="/deals/">Deals</a>
          <a href="/sitemap.xml">Sitemap</a>
        </nav>
        <p>© 2026 infonavigator.org — The independent, data-driven buying guide.</p>
        <p>We may earn a commission when you buy through links on this site. <a href="/disclosure/">Read our disclosure</a>.</p>
      </div>
    </footer>
  </body>
</html>
