---
import { SITE, NAV } from '../data/site';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  ogType?: string;
}

const { title, description, canonical, noindex, schema, ogType = 'article' } = Astro.props;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, SITE.url).toString();
const path = Astro.url.pathname;
const isCurrent = (href: string) => href === '/3d-printers/' ? path === href : path.startsWith(href);
const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="twitter:card" content="summary" />
    <!-- Google tag (gtag.js) — GA4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-8DBQMVX55W"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-8DBQMVX55W');
    </script>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='8' fill='%23131a2a'/><rect x='7' y='8' width='18' height='4' rx='1' fill='%23ffc92e'/><rect x='7' y='14' width='14' height='4' rx='1' fill='white'/><rect x='7' y='20' width='10' height='4' rx='1' fill='white'/></svg>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600..800&family=Hanken+Grotesk:ital,wght@0,400..700;1,400&display=swap" rel="stylesheet" />
    {schemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
  </head>
  <body>
    <header class="site">
      <div class="wrap-wide nav">
        <a class="brand" href="/">
          <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="#131a2a"/><rect x="7" y="8" width="18" height="4" rx="1" fill="#ffc92e"/><rect x="7" y="14" width="14" height="4" rx="1" fill="#fff"/><rect x="7" y="20" width="10" height="4" rx="1" fill="#fff"/></svg>
          InfoNavigator
        </a>
        <nav class="links" aria-label="Primary">
          {NAV.map((n) => <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site">
      <div class="wrap-wide">
        <a class="brand" href="/">
          <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="#fff" fill-opacity="0.1"/><rect x="7" y="8" width="18" height="4" rx="1" fill="#ffc92e"/><rect x="7" y="14" width="14" height="4" rx="1" fill="#fff"/><rect x="7" y="20" width="10" height="4" rx="1" fill="#fff"/></svg>
          InfoNavigator
        </a>
        <nav aria-label="Footer">
          <a href="/about/">About</a>
          <a href="/how-we-rate/">How we rate</a>
          <a href="/disclosure/">Affiliate disclosure</a>
          <a href="/deals/">Deals</a>
          <a href="/sitemap-index.xml">Sitemap</a>
        </nav>
        <div class="foot-text">
          <p>© 2026 infonavigator.org — The independent, data-driven buying guide.</p>
          <p>We may earn a commission when you buy through links on this site. <a href="/disclosure/">Read our disclosure</a>.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
