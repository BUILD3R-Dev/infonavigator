---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found — InfoNavigator"
  description="The page you were looking for does not exist."
  noindex={true}
>
  <div class="wrap wrap-center">
    <h1>That page doesn't exist.</h1>
    <p class="lede">The link may be old, or the address was typed wrong.</p>
    <p>
      <a class="btn" href="/">Back to the homepage</a>
      <a class="btn btn-ghost" href="/3d-printers/">Browse 3D printer guides</a>
    </p>
  </div>
</BaseLayout>
