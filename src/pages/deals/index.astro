---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import DisclosureBlock from '../../components/DisclosureBlock.astro';
import LastVerified from '../../components/LastVerified.astro';
---

<BaseLayout title="Deals — Price Drops Worth Knowing About (2026)" description="Current 3D printer deals and price drops, verified monthly. Only discounts on products we'd recommend anyway.">
  <div class="wrap">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Deals' }]} />
    <h1>Deals</h1>
    <p class="lede">Price drops on products we would recommend anyway. We track street prices monthly — a "deal" here means the price actually moved, not a fake MSRP discount.</p>

    <div class="card">
      <h3>Black Friday 2026 — live now</h3>
      <p>Every printer we track is on sale this week. Prices below are the manufacturers' US stores, verified November 23, 2026. Sale end dates differ per brand — check the store before you buy.</p>
      <table>
        <thead><tr><th>Printer</th><th>Sale price</th><th>List price</th><th>Sale ends</th></tr></thead>
        <tbody>
          <tr><td><a href="/3d-printers/bambu-lab-p2s-review/">Bambu Lab P2S</a></td><td>$449</td><td>$549</td><td>Dec 1</td></tr>
          <tr><td><a href="/3d-printers/bambu-lab-p2s-review/">Bambu Lab P2S Combo (AMS 2 Pro)</a></td><td>$649</td><td>$749</td><td>Dec 1</td></tr>
          <tr><td><a href="/3d-printers/bambu-lab-a1-combo-review/">Bambu Lab A1 Combo</a></td><td>$359</td><td>$399</td><td>Dec 1</td></tr>
          <tr><td><a href="/3d-printers/creality-k2-pro-review/">Creality K2 Pro</a></td><td>$549</td><td>$849</td><td>Nov 30</td></tr>
          <tr><td><a href="/3d-printers/creality-k2-pro-review/">Creality K2 Pro Combo (CFS)</a></td><td>$749</td><td>$1,099</td><td>Nov 30</td></tr>
          <tr><td><a href="/3d-printers/elegoo-centauri-carbon-review/">Elegoo Centauri Carbon</a></td><td>$289</td><td>$413</td><td>Dec 1</td></tr>
          <tr><td><a href="/3d-printers/elegoo-centauri-carbon-2-review/">Elegoo Centauri Carbon 2 Combo</a></td><td>$369</td><td>$449</td><td>Dec 1</td></tr>
          <tr><td><a href="/3d-printers/snapmaker-u1-review/">Snapmaker U1</a></td><td>$699</td><td>$999</td><td>Nov 30</td></tr>
          <tr><td><a href="/3d-printers/prusa-mk4s-review/">Prusa MK4S (assembled)</a></td><td>$925</td><td>$999</td><td>—</td></tr>
        </tbody>
      </table>
      <p class="muted">The Anycubic Kobra 3 ($349) is not in this table: the original model is sold out at Anycubic's US store, and the Kobra 4 / Kobra X now lead the line. The Prusa MK4S price is the current store price, not a dated Black Friday offer.</p>
    </div>

    <div class="card">
      <h3>How this page works</h3>
      <p>Every month we re-check street prices across our ranked products. When a product drops meaningfully below its verified price, it lands here with the before/after numbers and the date. No coupon-code theater.</p>
    </div>

    <LastVerified />
    <DisclosureBlock />
  </div>
</BaseLayout>
